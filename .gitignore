# Harbor job output
/jobs/

# Agent plugins vendored by configs/vendor-plugins.sh. The commits it pins are
# committed; the trees and the fetch cache are not.
/configs/plugins/
/configs/.cache/

# Python / uv
.venv/
__pycache__/
*.egg-info/

# API keys
.env*

# Maven
target/

# Vaadin generates these into the project dir if the frontend build ever runs
# locally. The task image deliberately has no Node, so they must never be
# committed or copied into it.
node_modules/
frontend/generated/
vite.generated.ts

# IDE metadata — must never reach a task image
.classpath
.project
.settings/
.idea/
*.iml

.DS_Store
