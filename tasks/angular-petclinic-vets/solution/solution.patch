+package ai.unifiedprocess.petclinic.vet;
+
+import ai.unifiedprocess.petclinic.BrowserTest;
+import com.microsoft.playwright.Locator;
+import com.microsoft.playwright.Page;
+import com.microsoft.playwright.options.AriaRole;
+import io.quarkus.test.junit.QuarkusTest;
+import org.junit.jupiter.api.Test;
+
+import java.util.regex.Pattern;
+
+import static com.microsoft.playwright.assertions.PlaywrightAssertions.assertThat;
+import static io.restassured.RestAssured.given;
+import static org.hamcrest.Matchers.contains;
+import static org.hamcrest.Matchers.hasSize;
+
+/**
+ * UC-002: View Veterinarians, against the V2 seed: six vets, Carter first.
+ */
+@QuarkusTest
+class UC002ViewVeterinariansTest extends BrowserTest {
+
+    @Test
+    void menuLeadsToTheVeterinarians() {
+        open("");
+        page.getByRole(AriaRole.LINK, new Page.GetByRoleOptions().setName("Veterinarians")).click();
+        assertThat(page).hasURL(Pattern.compile(".*/vets$"));
+        assertThat(page.getByRole(AriaRole.COLUMNHEADER))
+                .hasText(new String[] {"First Name", "Last Name", "Specialties"});
+    }
+
+    @Test
+    void specialtiesAreSortedAndNoneIsShown() {
+        open("vets");
+        Locator douglas = page.getByRole(AriaRole.ROW).filter(new Locator.FilterOptions().setHasText("Douglas"));
+        assertThat(douglas.getByRole(AriaRole.CELL).nth(2)).hasText("dentistry, surgery");
+        Locator carter = page.getByRole(AriaRole.ROW).filter(new Locator.FilterOptions().setHasText("Carter"));
+        assertThat(carter.getByRole(AriaRole.CELL).nth(2)).hasText("none");
+    }
+
+    @Test
+    void apiPagesByLastName() {
+        given().queryParam("offset", 0).queryParam("limit", 2)
+                .when().get("/api/vets")
+                .then().statusCode(200)
+                .body("$", hasSize(2))
+                .body("lastName", contains("Carter", "Douglas"));
+    }
+}
