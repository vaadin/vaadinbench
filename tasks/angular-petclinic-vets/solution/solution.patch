+import { HttpClient, HttpParams } from '@angular/common/http';
+import { Injectable, inject } from '@angular/core';
+import { Observable } from 'rxjs';
+
+/** One veterinarian as the API returns it. */
+export interface Vet {
+  readonly firstName: string;
+  readonly lastName: string;
+  /** Sorted alphabetically by the backend (UC-002 BR-002). */
+  readonly specialties: readonly string[];
+}
+
+@Injectable({ providedIn: 'root' })
+export class VetService {
+  private readonly http = inject(HttpClient);
+
+  /** The vets from `offset` on, at most `limit` of them, in list order. */
+  page(offset: number, limit: number): Observable<Vet[]> {
+    const params = new HttpParams().set('offset', offset).set('limit', limit);
+    return this.http.get<Vet[]>('/api/vets', { params });
+  }
+}
