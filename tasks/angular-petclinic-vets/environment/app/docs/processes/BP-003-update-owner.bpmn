<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_UpdateOwner" targetNamespace="http://bpmn.io/schema/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI">
  <bpmn:collaboration id="Collaboration_UpdateOwner">
    <bpmn:participant id="Participant_PetClinic" name="Spring PetClinic" processRef="BP-003" />
  </bpmn:collaboration>
  <bpmn:process id="BP-003" name="Update Owner" isExecutable="false">
    <bpmn:documentation>Goal: The clinic's contact details of an owner are correct again.
Trigger: An owner reports changed contact details.
Requirements: FR-007, FR-008, FR-010, FR-011, FR-012, FR-013
Status: Draft</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_UpdateOwner">
      <bpmn:lane id="Lane_ClinicUser" name="Clinic User">
        <bpmn:flowNodeRef>StartEvent_ContactDetailsChanged</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_FindOwners</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_OwnerOnRecord</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_ViewOwnerDetails</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_UpdateOwner</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ContactDetailsUpdated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_OwnerNotOnRecord</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_ContactDetailsChanged" name="Owner reports changed contact details" />
    <bpmn:userTask id="Activity_FindOwners" name="UC-004 Find Owners by Last Name" />
    <bpmn:exclusiveGateway id="Gateway_OwnerOnRecord" name="Owner on record?" />
    <bpmn:userTask id="Activity_ViewOwnerDetails" name="UC-005 View Owner Details" />
    <bpmn:userTask id="Activity_UpdateOwner" name="UC-006 Update Owner" />
    <bpmn:endEvent id="EndEvent_ContactDetailsUpdated" name="Contact details updated" />
    <bpmn:endEvent id="EndEvent_OwnerNotOnRecord" name="Owner not on record" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_ContactDetailsChanged" targetRef="Activity_FindOwners" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Activity_FindOwners" targetRef="Gateway_OwnerOnRecord" />
    <bpmn:sequenceFlow id="Flow_OwnerOnRecord_Yes" name="yes" sourceRef="Gateway_OwnerOnRecord" targetRef="Activity_ViewOwnerDetails" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Activity_ViewOwnerDetails" targetRef="Activity_UpdateOwner" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Activity_UpdateOwner" targetRef="EndEvent_ContactDetailsUpdated" />
    <bpmn:sequenceFlow id="Flow_OwnerOnRecord_No" name="no" sourceRef="Gateway_OwnerOnRecord" targetRef="EndEvent_OwnerNotOnRecord" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_UpdateOwner">
      <bpmndi:BPMNShape id="Participant_PetClinic_di" bpmnElement="Participant_PetClinic" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="978" height="240" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_ClinicUser_di" bpmnElement="Lane_ClinicUser" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="948" height="240" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_ContactDetailsChanged_di" bpmnElement="StartEvent_ContactDetailsChanged">
        <dc:Bounds x="302" y="122" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_FindOwners_di" bpmnElement="Activity_FindOwners">
        <dc:Bounds x="420" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_OwnerOnRecord_di" bpmnElement="Gateway_OwnerOnRecord" isMarkerVisible="true">
        <dc:Bounds x="595" y="115" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_ViewOwnerDetails_di" bpmnElement="Activity_ViewOwnerDetails">
        <dc:Bounds x="720" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_UpdateOwner_di" bpmnElement="Activity_UpdateOwner">
        <dc:Bounds x="870" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_ContactDetailsUpdated_di" bpmnElement="EndEvent_ContactDetailsUpdated">
        <dc:Bounds x="1052" y="122" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_OwnerNotOnRecord_di" bpmnElement="EndEvent_OwnerNotOnRecord">
        <dc:Bounds x="752" y="242" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="338" y="140" />
        <di:waypoint x="420" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="520" y="140" />
        <di:waypoint x="595" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_OwnerOnRecord_Yes_di" bpmnElement="Flow_OwnerOnRecord_Yes">
        <di:waypoint x="645" y="140" />
        <di:waypoint x="720" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="820" y="140" />
        <di:waypoint x="870" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="970" y="140" />
        <di:waypoint x="1052" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_OwnerOnRecord_No_di" bpmnElement="Flow_OwnerOnRecord_No">
        <di:waypoint x="620" y="165" />
        <di:waypoint x="620" y="260" />
        <di:waypoint x="752" y="260" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
